# Copia este fichero como .env (desarrollo local) — en Docker estas mismas
# variables se pasan vía env_file/environment en docker-compose.yml y NO se
# versiona ningún .env real.

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Formato: postgres://usuario:password@host:puerto/nombre_bd
# host=postgres → nombre del servicio en docker-compose.yml (uso normal).
# Si ejecutas el backend FUERA de Docker (venv local), cambia host a localhost.
DATABASE_URL=postgres://ticketing_user:ticketing_pass@postgres:5432/ticketing_db

CORS_ALLOWED_ORIGINS=http://localhost:5173
