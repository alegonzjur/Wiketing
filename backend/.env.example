# Copia este fichero como backend/.env (no se versiona).
# Una variable por línea con el formato CLAVE=valor: aquí NO va código Python.

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# True solo en desarrollo. En el servidor: False.
DJANGO_DEBUG=False
# Nombres/IP con los que se accederá a la app, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Formato: postgres://usuario:password@host:puerto/nombre_bd
# Si la contraseña tiene caracteres especiales (@ : / # ? %), codifícalos
# (p. ej. @ -> %40).
# Con Docker Compose el host es "postgres"; sin Docker, "localhost".
DATABASE_URL=postgres://ticketing_user:TU_PASSWORD@localhost:5432/ticketing_db

# Solo hace falta si usas `npm run dev` (Vite en 5173). Con el build servido
# por Django (mismo origen) no se usa.
CORS_ALLOWED_ORIGINS=http://localhost:5173
